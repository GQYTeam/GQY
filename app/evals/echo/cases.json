{
  "version": "1",
  "cases": [
    {
      "id": "echo-basic",
      "input": "请调用 echo 工具，把我这句话原样回显：hello",
      "expect": {
        "should_call": true,
        "tool": "echo__echo",
        "arg_contains": {"text": "hello"},
        "final_contains": ["hello"]
      }
    },
    {
      "id": "no-call-chat",
      "input": "你好，用一句话介绍你自己。",
      "expect": {
        "should_call": false,
        "must_not_call": true
      }
    },
    {
      "id": "echo-error",
      "input": "调用 echo 回显：fault-injection",
      "inject": {
        "mode": "error",
        "tool": "echo__echo",
        "times": 1,
        "message": "注入故障：示例错误"
      },
      "expect": {
        "should_call": true,
        "tool": "echo__echo",
        "arg_contains": {"text": "fault-injection"}
      }
    }
  ]
}
