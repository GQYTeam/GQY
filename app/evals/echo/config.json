{
  "name": "echo-tool",
  "tool": "echo__echo",
  "model": "deepseek/deepseek-chat",
  "cases": "cases.json",
  "repeats": 1,
  "concurrency": 1,
  "max_rounds": 4,
  "strict_schema": true,
  "stage": "single",
  "round": "r1",
  "axes": {
    "prompt": ["basic", "when-how", "strict"],
    "schema": ["min", "full", "example"],
    "return": ["raw", "summary"]
  },
  "fixed": {
    "prompt": "basic",
    "schema": "full",
    "return": "raw"
  },
  "timeouts": {
    "request_ms": 60000,
    "tool_ms": 10000,
    "total_ms": 180000,
    "retries": 1,
    "backoff_ms": 100,
    "backoff_max_ms": 1000
  }
}
