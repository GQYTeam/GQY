{
  "id": "echo",
  "name": "Echo 示例",
  "version": "1.0.0",
  "description": "回显输入，用于验证插件加载、调用与关闭链路。",
  "protocol": "gqy-jsonrpc-v1",
  "command": ["node", "index.js"],
  "timeout_ms": 5000,
  "concurrency": "concurrent",
  "actions": [
    {
      "name": "echo",
      "description": "把 text 原样返回；没有 text 时返回参数 JSON。",
      "schema": {
        "type": "object",
        "properties": {
          "text": {"type": "string", "description": "要回显的文本"}
        }
      }
    }
  ]
}
