# 复制为 .env 即可：server.go 启动时会自己读取，真实环境变量优先。
# 不填 GQY_API_KEY 时，前端自动回落本地演示回复。

GQY_API_KEY=
GQY_API_BASE=https://api.deepseek.com/v1
GQY_MODEL=deepseek-chat

# 请求协议：auto（默认，先试 chat，失败自动换 responses）| chat | responses
# GPT-5 系列 / agentrouter 这类中转只认 Responses API，就写 responses
# GQY_API_WIRE=auto

# 某些中转站按 User-Agent 拦截非官方客户端，需要时填它接受的 UA
# GQY_API_UA=

# 没有密钥时验证全链路：GQY_MOCK=1
# GQY_MOCK=1

# GQY_HOME=~/.gqy
# HOST=127.0.0.1
# PORT=5173

# 外部工具（插件/skill/mcp）注入模型；默认只注入核心工具（read/edit/shell/websearch/list_dir/ask_user）
# GQY_ENABLE_EXTERNAL=1

# provider_usage 工具：余额低于该值（单位与供应商一致，如 CNY 元）时提醒模型收尾
# GQY_LOW_BALANCE=5

# GitHub App OAuth（只读账户插件）
# 在 GitHub 创建 GitHub App 后填 Client ID / Secret，回调地址 http://127.0.0.1:5173/api/github/callback
# GITHUB_CLIENT_ID=
# GITHUB_CLIENT_SECRET=
# GITHUB_OAUTH_REDIRECT=http://127.0.0.1:5173/api/github/callback
