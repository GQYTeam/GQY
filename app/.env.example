# 启动参数：改动后需要重启（docs/designs/12-配置与热更新.md CF2）
# 数据根必须是绝对路径，不展开 ~
GQY_HOME=/Users/you/.gqy
HOST=127.0.0.1
PORT=5173

# 访问令牌：设置后 /api、/v1、/v1beta 全部要求 Bearer 或 cookie
# GQY_AUTH_TOKEN=

# 工具工作区与允许根
# GQY_WORKSPACE=/path/to/project
# GQY_TOOL_ROOTS=/path/a:/path/b

# 环境变量 provider 兜底：providers.json 缺失或为空时使用
# GQY_API_BASE=https://api.deepseek.com/v1
# GQY_API_KEY=
# GQY_MODEL=deepseek-chat

# 入口限流：每客户端每分钟请求数，0 表示不限
# GQY_RATE_LIMIT=0
